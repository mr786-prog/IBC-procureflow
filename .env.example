# ============================================================
# IBC ProcureFlow — Environment Variables Reference
# Copy this file to .env and fill in the values you need.
# NEVER commit .env with real credentials to source control.
# ============================================================

# ── Core ──────────────────────────────────────────────────────────────────────
APP_NAME="IBC ProcureFlow"
# APP_ENV: local | development | production
APP_ENV=local
APP_BASE_URL=http://localhost:8000
BACKUP_DIR=./backups

# ── Feature flags ─────────────────────────────────────────────────────────────
# Optional local-only demo account. No demo accounts are created by default.
DEMO_MODE=false
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=

# SESSION_COOKIE_SECURE=true sends the session cookie over HTTPS only.
# Leave false for local HTTP development; MUST be true outside local.
SESSION_COOKIE_SECURE=false

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres is primary when set. Use the connection URI from Dashboard → Connect.
# SUPABASE_DB_URL=postgresql://postgres:...@db.<project-ref>.supabase.co:5432/postgres
# Keep this password-bearing URI server-side only; do not use the publishable API key here.
# SQLite remains the local backup destination.
SQLITE_BACKUP_PATH=./backups/procureflow-latest.sqlite3
# For SQLite-only development, leave SUPABASE_DB_URL empty and use:
# DATABASE_URL=sqlite:///procureflow.db

# ── Auth & Sessions ───────────────────────────────────────────────────────────
SESSION_IDLE_MINUTES_MANAGER=30
SESSION_IDLE_MINUTES_EMPLOYEE=60

# Set to false to disable email+password login (force OAuth-only).
ALLOW_PASSWORD_LOGIN=true

# Initial production manager, entered as Render secret environment variables.
# These credentials create the manager only if the email is not already in the DB.
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# How to set up:
#   1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
#   2. Create an "OAuth 2.0 Client ID" (Web application type)
#   3. Add Authorised Redirect URI:
#      http://localhost:8000/api/v1/auth/google/callback  (local)
#      https://your-domain.com/api/v1/auth/google/callback  (production)
#   4. Paste the Client ID and Secret below.
#
# When both values are set the "Sign in with Google" button appears on the
# login page.  When either is empty the button is hidden and the Google OAuth
# routes return HTTP 503.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Supabase API keys (optional, not used for PostgreSQL database access) ─────
# The project URL/publishable key are for Supabase APIs. Database access uses
# SUPABASE_DB_URL above, not the publishable key.
# How to set up:
#   1. Create a project at https://supabase.com/
#   2. Project Settings → API → copy the values below.
SUPABASE_URL=
# Use the publishable key from Supabase Project Settings → API Keys.
SUPABASE_PUBLISHABLE_KEY=
# Legacy project key name is also accepted if already configured.
SUPABASE_ANON_KEY=
# Optional; never expose this key in browser code.
SUPABASE_SERVICE_KEY=

# ── Zoho OAuth (optional) ─────────────────────────────────────────────────────
# Enables item and vendor sync with Zoho Books / Zoho Inventory.
# How to set up:
#   1. Go to https://api-console.zoho.in/ (or .com for non-India accounts)
#   2. Create a "Server-based Application"
#   3. Add Authorised Redirect URI:
#      http://localhost:8000/api/v1/auth/zoho/callback  (local)
#      https://your-domain.com/api/v1/auth/zoho/callback  (production)
#   4. Grant scopes: ZohoBooks.items.READ, ZohoBooks.contacts.READ
#   5. Paste the Client ID and Secret below.
#   6. ZOHO_REDIRECT_URI is auto-derived from APP_BASE_URL; override only if needed.
#   7. ZOHO_ORGANIZATION_ID: Zoho Books → Settings → Organisation Profile → Org ID.
#
# When both values are set a manager can connect Zoho from Settings → Integrations.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# ZOHO_REDIRECT_URI=
# ZOHO_ORGANIZATION_ID=
